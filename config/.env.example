; AMN International - example environment file.
; Copy this file to config/.env and adjust the values for your server.
; Never commit the real config/.env to version control.

APP_NAME="AMN International"
APP_ENV=local
; base URL of the project (no trailing slash). Leave empty for auto-detect.
APP_URL=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kabul
; Set to false if mod_rewrite / URL rewriting is not available on your host.
URL_REWRITE=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amn_international
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

; Maximum size of uploaded images in kilobytes
UPLOAD_MAX_KB=3072
SESSION_NAME=AMN_SESS
